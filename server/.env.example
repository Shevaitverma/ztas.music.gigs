# ============================================
# ZTS Music Platform API - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
PORT=8080
# IANA timezone the event wall-clock (eventTiming.date + startTime/endTime) is
# interpreted in. Independent of the server's own TZ. India-only product today.
APP_TIMEZONE=Asia/Kolkata

# ============================================
# Database (MongoDB)
# ============================================
# Local development
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=music-server

# Production (MongoDB Atlas example)
# DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net

# ============================================
# Firebase Admin SDK
# ============================================
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ============================================
# JWT Authentication
# ============================================
# Generate strong secrets: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRATION=7d

# ============================================
# Field-Level Encryption (PII at rest)
# ============================================
# REQUIRED in production. 32 bytes (64 hex chars).
# Generate with: openssl rand -hex 32
# Used to encrypt Aadhaar/PAN/bank account/IFSC at rest.
ENCRYPTION_KEY=

# ============================================
# Rate Limiter / Trusted Proxies
# ============================================
# Comma-separated source IPs that are allowed to set X-Forwarded-For.
# Direct connections from other IPs are rate-limited by their socket IP.
# Default: 127.0.0.1,::1
TRUSTED_PROXIES=127.0.0.1,::1

# Rate limiter mode: off | log | enforce   (default: log)
#   off     - limiter does nothing.
#   log     - counts requests and logs "[RateLimit] WOULD BLOCK ..." when a cap
#             is exceeded, but never returns 429.
#   enforce - returns 429 once a cap is exceeded.
#
# ROLLOUT: these caps have never seen real traffic. Run in `log` for a few days,
# grep the logs for "[RateLimit] WOULD BLOCK", tune the caps in
# DEFAULT_ROUTE_LIMITS (src/plugins/security.plugin.ts) against what you see,
# THEN switch to `enforce`. Flipping straight to enforce risks browning out the
# API for legitimate clients.
#
# NOTE: counters are per-process and in-memory — they reset on deploy and do not
# aggregate across instances. Redis is the real fix (post-beta).
RATE_LIMIT_MODE=log

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# In production: REQUIRED, comma-separated origin list, MUST NOT contain "*"
# (wildcard + credentials:true is rejected by browsers and unsafe).
#
# Example production:
# CORS_ORIGIN=https://app.zts.music,https://admin.zts.music

# ============================================
# AWS S3 (Optional - for file uploads)
# ============================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name
AWS_PRESIGNED_URL_EXPIRY=3600

# ============================================
# Email Delivery (Resend)
# ============================================
# EMAIL_ENABLED defaults to false. When false (or RESEND_API_KEY is empty),
# nothing is sent — the message that WOULD have gone out is logged instead.
# Keep it false in local dev and CI.
EMAIL_ENABLED=false
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sender/domain in Resend.
EMAIL_FROM=ZTS Music <noreply@yourdomain.com>

# ============================================
# Error Tracking (Sentry)
# ============================================
# Leave empty to disable — Sentry.init() is skipped and all capture calls no-op.
# Cookie/Authorization headers and auth/verification request bodies are scrubbed
# before send (see scrubSentryEvent in src/plugins/error.plugin.ts).
SENTRY_DSN=

# ============================================
# Logging
# ============================================
# Log levels: debug, info, warn, error
LOG_LEVEL=info

# ============================================
# Feature Flags
# ============================================
# Enable activity logging (enabled by default)
# Activity logs track admin/user actions on PII for audit purposes
# Set to 'false' only if you explicitly do not want audit trails
ENABLE_ACTIVITY_LOGGING=true

# Verbose auth-plugin debug logs (NEVER logs tokens or full payloads).
# Default: false. Set to 'true' only for local debugging.
AUTH_DEBUG_LOGGING=false
