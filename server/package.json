{
  "name": "ai.zts.music.server",
  "version": "1.0.0",
  "description": "ZTS Music Platform API - Bun + Elysia Backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --minify --sourcemap",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rm -rf dist node_modules/.cache"
  },
  "keywords": ["music", "gig", "marketplace", "bun", "elysia", "api"],
  "author": "ZTS Music Platform",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.9.5",
    "bun-types": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "overrides": {
    "bson": "7.2.0",
    "protobufjs": "^7.5.9",
    "@grpc/grpc-js": "^1.14.4",
    "websocket-driver": "^0.7.5",
    "@tootallnate/once": "^2.0.1",
    "form-data": "^2.5.6",
    "file-type": "^21.3.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@aws-sdk/s3-request-presigner": "^3.1102.0",
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@sentry/bun": "^10.69.0",
    "elysia": "^1.4.29",
    "firebase-admin": "^13.10.0",
    "mongoose": "^9.9.1",
    "resend": "^6.18.1"
  }
}
