# ============================================
# ZTS Music — Web (client) frontend  ·  dev port :3000
# ============================================
# Copy to .env.local and fill in. .env.local is gitignored.
# NEXT_PUBLIC_* are inlined into the client bundle at build time and are PUBLIC.
# Never put server secrets here.

# --- Backend API ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/bids

# Server-side fetches (SSR/middleware). Optional — falls back to API_URL.
# INTERNAL_API_URL=http://localhost:8080/api/v1

# --- Marketing site ---
# Hosts the canonical /terms and /privacy pages (see landing/). Optional.
# Defaults to https://gigs.ztas.in if unset.
NEXT_PUBLIC_LANDING_URL=http://localhost:3002

# --- Admin console ---
# Separate Next app (admin/, dev port :3001). /admin in this app redirects here.
# Defaults to http://localhost:3001 if unset.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# --- Product analytics (PostHog) ---
# OPTIONAL. Leave the key blank and analytics is completely inert: posthog-js
# is never loaded, no network request is made, nothing throws. Set it only in
# staging/production. PostHog > Project Settings > Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=
# Region host. EU: https://eu.i.posthog.com  ·  self-hosted: your own origin.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Firebase Web SDK (public per Firebase) ---
# Firebase Console > Project Settings > General > Your apps (Web app).
# authDomain/storageBucket are derived from project ID if omitted.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zts-music
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zts-music.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zts-music.appspot.com
